# Runtime state written by the DE1app on the tablet -- personal data,
# never committed (per the plugin's packaging rules).
settings.tdb
last_recommendation.tdb
last_state.tdb
*.tdb

# Espresso databases and shot history -- personal data, never public.
*.db
*.sqlite
*.sqlite3
history/
history_v2/
history_archive/
*.shot

# Local backup/trash/log folders (never shipped)
backups/
trash/
logs/
*.bak
trash_manifest.txt
delete_log.txt

# Version archives
*Archive/

# Internal working notes -- kept local, never published. They record tablet
# and network details (device address, local paths) that have no place in a
# public repo, and nothing in the plugin needs them at runtime.
PROJECT_STATE.md

# OS junk
desktop.ini
Thumbs.db
.DS_Store
